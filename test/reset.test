import test from "node:test";
import assert from "node:assert/strict";
import { DatabaseSync } from "node:sqlite";
import worker from "../src/worker.js";

const BASE = "https://wielerschema.test";
class FakeD1 {
  constructor() { this.db = new DatabaseSync(":memory:"); }
  prepare(sql) { const db = this.db; return {
    args: [], bind(...a) { this.args = a.map(v => (v === undefined ? null : v)); return this; },
    async first() { return db.prepare(sql).get(...this.args) ?? null; },
    async all() { return { results: db.prepare(sql).all(...this.args) }; },
    async run() { const r = db.prepare(sql).run(...this.args); return { meta: { changes: r.changes } }; } }; }
  async batch(s) { for (const x of s) await x.run(); return []; }
}
let prompts = [];
const realFetch = globalThis.fetch;
const week = () => ({ dagen: Array.from({ length: 7 }, (_, d) => ({ dag: d, type: "duurrit", minuten: 60, zone: "Z2", titel: "Duur", beschrijving: "Rustig." })), tips: "x" });
globalThis.fetch = async (url, init) => {
  if (!String(url).includes("api.groq.com")) return realFetch(url, init);
  const p = JSON.parse(init.body).messages[1].content; prompts.push(p);
  let content = "{}";
  const m = p.match(/trainingsschema van (\d+) weken/);
  if (m) content = JSON.stringify({ samenvatting: "ok", weken: Array.from({ length: Number(m[1]) }, (_, i) => ({ week: i + 1, fase: "opbouw", focus: "Basis", uren: 6 })), week1: week() });
  return new Response(JSON.stringify({ choices: [{ message: { content } }] }), { status: 200 });
};
const future = d => { const x = new Date(); x.setUTCDate(x.getUTCDate() + d); return x.toISOString().slice(0, 10); };
const base = (extra = {}) => ({ doel: "Wedstrijdseizoen", datum: null, niveau: "gevorderd", uren_per_week: 6, dagen: [1, 3, 5, 6], geboortedatum: "1990-06-15", meter: "none", ...extra });
let n = 0;
async function api(env, method, path, body, cookie) {
  const h = { "CF-Connecting-IP": `10.3.0.${++n}` }; if (body) h["Content-Type"] = "application/json"; if (cookie) h.Cookie = cookie;
  const res = await worker.fetch(new Request(BASE + path, { method, headers: h, body: body ? JSON.stringify(body) : undefined }), env);
  const sc = res.headers.get("Set-Cookie"); const m = sc && sc.match(/__Host-ws=([0-9a-f]{64})/);
  return { status: res.status, data: await res.json().catch(() => ({})), cookie: m ? `__Host-ws=${m[1]}` : null };
}
const signup = async (env, name = "renner") => (await api(env, "POST", "/api/register", { username: name, password: "een-lang-wachtwoord", consent: true })).cookie;
const makeEnv = () => ({ DB: new FakeD1(), GROQ_API_KEY: "x" });
const ZOHO = { ZOHO_CLIENT_ID: "cid", ZOHO_CLIENT_SECRET: "secret", ZOHO_REFRESH_TOKEN: "refresh", ZOHO_DC: "eu" };
let mails = [], mailFails = false;
const wrapped = globalThis.fetch;
globalThis.fetch = async (url, init) => {
  const u = String(url);
  if (u.includes("accounts.zoho.")) return new Response(JSON.stringify({ access_token: "tok" }), { status: 200 });
  if (u === "https://mail.zoho.eu/api/accounts") return new Response(JSON.stringify({ data: [{ accountId: "12345" }] }), { status: 200 });
  if (u === "https://mail.zoho.eu/api/accounts/12345/messages") {
    const body = JSON.parse(init.body);
    mails.push({ ...body, auth: init.headers.Authorization });
    return new Response(JSON.stringify(mailFails ? { status: { code: 500 } } : { status: { code: 200 } }), { status: mailFails ? 500 : 200 });
  }
  return wrapped(url, init);
};
const reg = (env, username, email, ip = "10.1.1.1") => api(env, "POST", "/api/register", { username, password: "een-lang-wachtwoord", consent: true, email }, undefined, ip);
const forgot = (env, email, ip) => api(env, "POST", "/api/password/forgot", { email }, undefined, ip);
const tokenOf = mail => mail.content.match(/#herstel=([a-f0-9]{64})/)[1];
const login = (env, username, password) => api(env, "POST", "/api/login", { username, password });

test("herstel: mail met link voor een bekend adres, hetzelfde antwoord voor een onbekend adres", async () => {
  mails = []; mailFails = false;
  const env = { ...makeEnv(), ...ZOHO };
  await reg(env, "renner", "Renner@Voorbeeld.nl");
  const known = await forgot(env, "renner@voorbeeld.nl");
  const unknown = await forgot(env, "niemand@voorbeeld.nl");
  assert.equal(known.status, 200); assert.equal(unknown.status, 200);
  assert.equal(known.data.message, unknown.data.message, "geen verschil zichtbaar");
  assert.equal(mails.length, 1, "alleen voor het bekende adres een mail");
  assert.equal(mails[0].toAddress, "renner@voorbeeld.nl");
  assert.equal(mails[0].fromAddress, "hessel@wielerschema.me");
  assert.equal(mails[0].auth, "Zoho-oauthtoken tok");
  assert.equal(mails[0].mailFormat, "plaintext");
  assert.match(mails[0].content, /https:\/\/wielerschema\.me\/#herstel=[a-f0-9]{64}/);
  assert.match(mails[0].content, /"renner"/);
});

test("herstel: met de link kies je een nieuw wachtwoord; oude wachtwoord en sessies werken niet meer, de link maar één keer", async () => {
  mails = [];
  const env = { ...makeEnv(), ...ZOHO };
  const cookie = (await reg(env, "renner", "renner@voorbeeld.nl")).cookie;
  await forgot(env, "renner@voorbeeld.nl");
  const token = tokenOf(mails[0]);
  assert.equal((await api(env, "POST", "/api/password/reset", { token, password: "kort" })).status, 400, "te kort wachtwoord");
  assert.equal((await api(env, "POST", "/api/password/reset", { token: "x".repeat(64), password: "nieuw-lang-wachtwoord" })).status, 400, "onbekende token");
  assert.equal((await api(env, "POST", "/api/password/reset", { token: "nope", password: "nieuw-lang-wachtwoord" })).status, 400, "ongeldige token");
  assert.equal((await api(env, "POST", "/api/password/reset", { token, password: "nieuw-lang-wachtwoord" })).status, 200);
  assert.equal((await login(env, "renner", "nieuw-lang-wachtwoord")).status, 200);
  assert.equal((await login(env, "renner", "een-lang-wachtwoord")).status, 401, "oud wachtwoord werkt niet meer");
  assert.equal((await api(env, "GET", "/api/me", undefined, cookie)).status, 401, "oude sessie is uitgelogd");
  assert.equal((await api(env, "POST", "/api/password/reset", { token, password: "weer-een-nieuw-wachtwoord" })).status, 400, "link is eenmalig");
  assert.ok(!JSON.stringify(env.DB.db.prepare("SELECT * FROM password_resets").all()).includes(token), "de token zelf wordt niet bewaard");
});

test("herstel: verlopen link, nieuwe aanvraag maakt de oude ongeldig, en verwijderen ruimt op", async () => {
  mails = [];
  const env = { ...makeEnv(), ...ZOHO };
  await reg(env, "renner", "renner@voorbeeld.nl");
  await forgot(env, "renner@voorbeeld.nl");
  const first = tokenOf(mails[0]);
  await forgot(env, "renner@voorbeeld.nl");
  const second = tokenOf(mails[1]);
  assert.notEqual(first, second);
  assert.equal((await api(env, "POST", "/api/password/reset", { token: first, password: "nieuw-lang-wachtwoord" })).status, 400, "oude link vervangen");
  env.DB.db.prepare("UPDATE password_resets SET expires_at = ?").run(Date.now() - 1000);
  assert.equal((await api(env, "POST", "/api/password/reset", { token: second, password: "nieuw-lang-wachtwoord" })).status, 400, "verlopen");
  await forgot(env, "renner@voorbeeld.nl");
  const cookie = (await login(env, "renner", "een-lang-wachtwoord")).cookie;
  assert.equal((await api(env, "POST", "/api/account/delete", { password: "een-lang-wachtwoord" }, cookie)).status, 200);
  assert.equal(env.DB.db.prepare("SELECT COUNT(*) AS n FROM password_resets").get().n, 0);
});

test("herstel: ongeldig adres, limieten, niet ingesteld en gedeeld adres", async () => {
  mails = []; mailFails = false;
  const env = { ...makeEnv(), ...ZOHO };
  assert.equal((await forgot(env, "")).status, 400);
  assert.equal((await forgot(env, "geen-adres")).status, 400);
  await reg(env, "ouder", "gezin@voorbeeld.nl", "10.3.3.3");
  await reg(env, "kind", "gezin@voorbeeld.nl", "10.4.4.4");
  await forgot(env, "gezin@voorbeeld.nl", "10.5.5.5");
  assert.equal(mails.length, 2, "elk account op dit adres krijgt een eigen link");
  assert.notEqual(tokenOf(mails[0]), tokenOf(mails[1]));
  await forgot(env, "gezin@voorbeeld.nl", "10.5.5.6"); await forgot(env, "gezin@voorbeeld.nl", "10.5.5.7");
  assert.equal((await forgot(env, "gezin@voorbeeld.nl", "10.5.5.8")).status, 429, "maximaal 3 aanvragen per adres per dag");
  const unconfigured = makeEnv();
  await reg(unconfigured, "renner", "renner@voorbeeld.nl");
  const r = await forgot(unconfigured, "renner@voorbeeld.nl");
  assert.equal(r.status, 503);
  assert.match(r.data.message, /hessel@wielerschema\.me/);
});

test("herstel: een mislukte mail laat het antwoord ongewijzigd en lekt niets", async () => {
  mails = []; mailFails = true;
  const env = { ...makeEnv(), ...ZOHO };
  await reg(env, "renner", "renner@voorbeeld.nl");
  const r = await forgot(env, "renner@voorbeeld.nl");
  assert.equal(r.status, 200);
  assert.ok(!JSON.stringify(r.data).includes("herstel="));
  mailFails = false;
});